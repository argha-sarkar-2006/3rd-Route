# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real keys.

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=PASTE_YOUR_OPENROUTER_API_KEY_HERE
# Optional second key, used by the document workbench
OPENROUTER_API_KEY_ALT=PASTE_YOUR_OPENROUTER_API_KEY_HERE

# Ollama Cloud — https://ollama.com/settings/keys
OLLAMA_API_KEY=PASTE_YOUR_OLLAMA_API_KEY_HERE
